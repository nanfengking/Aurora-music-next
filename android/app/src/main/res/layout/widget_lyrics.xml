<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="18dp" android:background="@drawable/widget_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/widget_accent" android:layout_width="18dp" android:layout_height="3dp" android:background="#b94b5c" android:layout_marginEnd="9dp" />
        <TextView android:id="@+id/widget_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/app_name" android:textSize="12sp" android:fontFamily="sans-serif-medium" android:maxLines="1" android:ellipsize="end" />
        <ImageView android:id="@+id/widget_cover" android:layout_width="28dp" android:layout_height="28dp" android:scaleType="centerCrop" android:contentDescription="@string/widget_artwork" android:visibility="gone" />
    </LinearLayout>
    <TextView android:id="@+id/widget_lyric" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:text="@string/widget_no_lyrics" android:textSize="25sp" android:fontFamily="sans-serif-medium" android:maxLines="3" android:ellipsize="end" android:layout_marginTop="8dp" />
    <TextView android:id="@+id/widget_next_lyric" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/widget_artist" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/widget_brand" android:textSize="11sp" android:letterSpacing="0.06" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/widget_previous" android:layout_width="48dp" android:layout_height="48dp" android:text="@string/widget_previous_icon" android:gravity="center" android:contentDescription="@string/widget_previous" />
        <TextView android:id="@+id/widget_toggle" android:layout_width="48dp" android:layout_height="48dp" android:text="@string/widget_play_icon" android:gravity="center" android:textSize="21sp" android:contentDescription="@string/widget_play_pause" />
        <TextView android:id="@+id/widget_next" android:layout_width="48dp" android:layout_height="48dp" android:text="@string/widget_next_icon" android:gravity="center" android:contentDescription="@string/widget_next" />
    </LinearLayout>
</LinearLayout>
